# Ignore virtual environment directories
env/
venv/

# Ignore Git files
.git/
.gitignore

# Ignore Python cache files
__pycache__/
*.pyc

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore log files
*.log

# Ignore large dataset files
*.csv
*.xls
*.xlsx
*.json

# Ignore unnecessary documentation files
*.md
*.rst

# Ignore environment configuration files
.env
.env.local
*.env.*

# Ignore editor-specific files
.DS_Store
.idea/
.vscode/

# Ignore npm and Node.js directories
node_modules/

# Ignore other unwanted large directories
*.zip
*.tar.gz
*.rar
*.7z
